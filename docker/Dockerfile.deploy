# syntax=docker/dockerfile:1.7
# Deployment Dockerfile: Framework content baked for portability
# Difference from dev: COPY .maceff/framework/ into image (no bind mount needed)

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
SHELL ["/bin/bash","-lc"]

RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg sudo openssh-server \
      git vim less build-essential python3 python3-venv python3-pip \
      nodejs npm \
      acl jq tini \
      tree \
      tmux rsync \
 && rm -rf /var/lib/apt/lists/*

# GitHub CLI (gh) for automation
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
 && apt-get update \
 && apt-get install -y gh \
 && rm -rf /var/lib/apt/lists/*

# Python symlink for hooks compatibility (hooks use #!/usr/bin/env python)
RUN ln -s /usr/bin/python3 /usr/bin/python

RUN npm install -g @anthropic-ai/claude-code
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# === DEPLOYMENT-SPECIFIC: Bake framework content for portability ===
# In dev mode, this comes from bind mount (.maceff/framework/)
# In deploy mode, we bake it into the image (no host dependencies)
COPY .maceff/framework /opt/maceff/framework

# Set correct permissions for framework content
RUN find /opt/maceff/framework -type d -exec chmod 755 {} \; && \
    find /opt/maceff/framework -type f -exec chmod 644 {} \;

# Copy skeleton bashrc for new users (includes venv activation)
COPY docker/skel/.bashrc /etc/skel/.bashrc
RUN chmod 644 /etc/skel/.bashrc

# admin (sudoer), at the deployment's id block, as docker/Dockerfile does: MACEFF_ID_BASE .. +999,
# declared again as ids.base in agents.yaml (container_operations 6.2). The base image's ubuntu
# account goes: its uid 1000 is the first human login on most hosts, and start-up refuses an
# image that still has it.
ARG MACEFF_ID_BASE
RUN set -eux; \
    b="${MACEFF_ID_BASE:?build with --build-arg MACEFF_ID_BASE=<the deployment block, e.g. 21000>}"; \
    [ "$b" -ge 20000 ] && [ $((b % 1000)) -eq 0 ] || { echo "MACEFF_ID_BASE must be a multiple of 1000, at least 20000 (got $b)" >&2; exit 1; }; \
    if id ubuntu >/dev/null 2>&1; then userdel -r ubuntu; fi; \
    groupadd -g "$b" admin; \
    useradd -m -s /bin/bash -u "$b" -g "$b" admin; \
    echo "admin ALL=(ALL) NOPASSWD:ALL" >/etc/sudoers.d/90-admin; \
    chmod 0440 /etc/sudoers.d/90-admin; \
    if getent passwd 1000; then echo "uid 1000 is still taken in the image" >&2; exit 1; fi; \
    id admin

# SSH hardening
RUN mkdir -p /var/run/sshd /etc/ssh/sshd_config.d \
 && printf '%s\n' \
    'PasswordAuthentication no' \
    'PermitRootLogin no' \
    'X11Forwarding no' \
    'ClientAliveInterval 60' \
    'ClientAliveCountMax 10' \
  > /etc/ssh/sshd_config.d/10-container.conf

# Runner used for parallel SA jobs (scoped via sudoers)
# sa-exec runner
COPY docker/sa-exec /usr/local/bin/sa-exec
RUN chmod 0755 /usr/local/bin/sa-exec

COPY docker/start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

EXPOSE 22
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["/usr/local/bin/start.sh"]
