#!/opt/maceff-venv/bin/python3
"""git credential helper: answer with this agent's GitHub App token for the repository asked.

Configure once per agent, in this order (git_discipline, section 4). The empty value resets
the list, so a helper configured earlier (a system-wide osxkeychain, `gh auth setup-git`'s)
cannot answer first; the operator's helper goes last, for repositories the app is not on:

    git config --global --replace-all credential.https://github.com.helper ''
    git config --global --add credential.https://github.com.helper /opt/maceff-ghapp/git-credential-ghapp
    git config --global --add credential.https://github.com.helper '!gh auth git-credential'
    git config --global credential.https://github.com.useHttpPath true

Where several agents share one login, use `git -C <the agent's clone> config` instead of
`--global`, or the operator's own pushes go out as the agent's app.

useHttpPath makes git send the path, so the token is minted for, and scoped to, exactly that
repository.
Where the app is not installed it answers nothing and git falls back to the next helper. The
token never appears on a command line or in a remote URL. The app is ghapp.py's choice:
$GHAPP_NAME, else the only app in the agent's home.
"""
import os, subprocess, sys

if len(sys.argv) < 2 or sys.argv[1] != "get":
    sys.exit(0)
req = dict(line.split("=", 1) for line in sys.stdin.read().splitlines() if "=" in line)
if req.get("host") != "github.com" or not req.get("path"):
    sys.exit(0)
repo = req["path"].removesuffix(".git").lower()
tool = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ghapp.py")
r = subprocess.run([sys.executable, "-I", tool, "token", "--repo", repo, "--expiry"], capture_output=True, text=True)
if r.returncode == 0 and r.stdout:
    token, _, expiry = r.stdout.partition("\n")
    # The expiry lets git (2.41+) and the stores that honor it drop the token when it lapses,
    # rather than a later helper in the list keeping a dead credential.
    sys.stdout.write(f"username=x-access-token\npassword={token}\n"
                     + (f"password_expiry_utc={expiry.strip()}\n" if expiry.strip() else ""))
elif r.returncode not in (0, 3):
    # Not "not installed here" but broken: say so, since git will quietly use the next helper.
    sys.stderr.write(f"git-credential-ghapp: no app token for {repo}: {r.stderr.strip()[:200]}\n")
