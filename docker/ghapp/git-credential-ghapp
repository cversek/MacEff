#!/opt/maceff-venv/bin/python3
"""git credential helper: answer with this agent's GitHub App token for the repository asked.

Configure once per agent (git_discipline, section 4):

    git config --global credential.https://github.com.helper /opt/maceff-ghapp/git-credential-ghapp
    git config --global credential.https://github.com.useHttpPath true

useHttpPath makes git send the path, so the token is minted for exactly that repository.
Where the app is not installed it answers nothing and git falls back to the next helper. The
token never appears on a command line or in a remote URL. The app is ghapp.py's choice:
$GHAPP_NAME, else the only app in the agent's home.
"""
import os, subprocess, sys

if len(sys.argv) < 2 or sys.argv[1] != "get":
    sys.exit(0)
req = dict(line.split("=", 1) for line in sys.stdin.read().splitlines() if "=" in line)
if req.get("host") != "github.com" or not req.get("path"):
    sys.exit(0)
repo = req["path"].removesuffix(".git").lower()
tool = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ghapp.py")
r = subprocess.run([sys.executable, "-I", tool, "token", "--repo", repo], capture_output=True, text=True)
if r.returncode == 0 and r.stdout:
    sys.stdout.write(f"username=x-access-token\npassword={r.stdout}\n")
elif r.returncode not in (0, 3):
    # Not "not installed here" but broken: say so, since git will quietly use the next helper.
    sys.stderr.write(f"git-credential-ghapp: no app token for {repo}: {r.stderr.strip()[:200]}\n")
