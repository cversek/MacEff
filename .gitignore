# Local Makefile backups
Makefile.bak.*

# Local Makefile backups
Makefile.bak.*
# SSH keys: keep only public keys in git
keys/*
!keys/*.pub
# MacEff customization layer (user-specific, created by maceff-init)
# NOTE: gitignore treats '#' as a comment only at the START of a line. These
# four patterns carried trailing inline comments, which made each pattern the
# literal string "path/ # comment ..." — matching nothing. They looked
# configured and ignored nothing for as long as they had existed.
# All framework content (policies, templates, agent_defs)
.maceff/framework/
# All configuration (env files, config.json)
.maceff/config/
# Session state files (runtime artifacts)
.maceff/sessions/
# Agent cycle/state tracking (runtime artifact)
.maceff/agent_state.json

# Optional: Keep example templates in git if needed
# !.maceff/config/config.json.example
# !.maceff/framework/.gitkeep

# Local backup files
docker-compose.yml.bak.*
docker/start.sh.bak.*
tools/bin/*.bak.*
LEGACY_POLICIES_NO_VCS/
.git.backup-before-redaction/

# Local docker-compose overrides (environment-specific)
docker-compose.override.yml

# Voice training data and domain-specific correction patterns (local data, not code)
macf/src/macf/voice/training_data/
macf/src/macf/voice/fusion_patterns.json

