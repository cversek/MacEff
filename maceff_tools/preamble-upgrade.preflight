#!/usr/bin/env bash
# Precondition for preamble-upgrade: can it run at all?
#
# preamble-upgrade is the last step of framework-upgrade, and the three steps
# before it have already written by the time it starts. So its requirements are
# checked HERE, before step 1, and a failure refuses the whole upgrade instead of
# half-applying it. See maceff_tools/framework-upgrade.
#
# Exits 0 if the step could run. On failure, prints what is wrong AND the
# variable that fixes it — the remedy belongs in the error, not in the source.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

CONTAINER="${CONTAINER_NAME:-maceff-sandbox}"
rc=0

# framework-upgrade runs preamble-upgrade for every agent the deployment declares (#388), so
# what it needs is: the container, a readable declaration with at least one MacEff agent, and
# each such agent's account in the container.
ENUM_PY='
import yaml
from macf.models.agent_spec import AgentsConfig
c = AgentsConfig.model_validate(yaml.safe_load(open("/etc/maceff/agents.yaml")))
print("\n".join(s.username for s in c.agents.values() if not s.is_vanilla))
'
if ! docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q '^true$'; then
  echo "preamble-upgrade: container '${CONTAINER}' is not running." >&2
  echo "                  set CONTAINER_NAME=<name> for this deployment, or start it." >&2
  rc=1
elif ! users="$(docker exec "$CONTAINER" /opt/maceff-venv/bin/python -c "$ENUM_PY" 2>/dev/null)"; then
  echo "preamble-upgrade: cannot read the agents from /etc/maceff/agents.yaml in '${CONTAINER}'." >&2
  rc=1
elif [[ -z "$users" ]]; then
  echo "preamble-upgrade: '${CONTAINER}' declares no MacEff agent; there is nothing to upgrade." >&2
  rc=1
else
  while IFS= read -r u; do
    if ! docker exec "$CONTAINER" id "$u" >/dev/null 2>&1; then
      echo "preamble-upgrade: declared agent '${u}' has no account in '${CONTAINER}'." >&2
      rc=1
    fi
  done <<< "$users"
fi

exit "$rc"
