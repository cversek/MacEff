{
  "version": 1,
  "agent": "ExampleAgent@abc123",
  "units": [
    {
      "name": "session",
      "command": [
        "maceff_harness_start_ExampleAgent_abc123"
      ],
      "account": "example",
      "restart": "on-failure",
      "liveness_interval_s": 60,
      "memory_limit_mb": 4096,
      "kind": "session",
      "stop_grace_s": 30
    },
    {
      "name": "transcript-monitor",
      "command": [
        "macf_tools",
        "transcript-monitor",
        "start"
      ],
      "account": "example",
      "restart": "always",
      "liveness_interval_s": 30,
      "memory_limit_mb": 256
    },
    {
      "name": "amail-broker",
      "command": [
        "python3",
        "-m",
        "macf.amail.daemons.broker"
      ],
      "account": "example",
      "restart": "always",
      "exit_codes": {
        "success": [
          0
        ],
        "no_restart": [
          78
        ]
      },
      "liveness_interval_s": 60,
      "memory_limit_mb": 256,
      "environment": {
        "PYTHONUNBUFFERED": "1",
        "MACEFF_AGENT_HOME_DIR": "{agent_home}"
      },
      "stop_grace_s": 60
    },
    {
      "name": "amail-receiver",
      "command": [
        "python3",
        "-m",
        "macf.amail.daemons.receiver"
      ],
      "account": "example",
      "restart": "on-failure",
      "liveness_interval_s": 120,
      "memory_limit_mb": 128,
      "optional": true
    }
  ],
  "schedules": [
    {
      "name": "morning-sweep",
      "cron": "45 6 * * *",
      "missed_run": {
        "kind": "run_once_in_window",
        "window": {
          "start": "06:45",
          "end": "09:00"
        }
      },
      "target": "isolated",
      "run": {
        "prompt_file": "agent/private/schedules/morning-sweep.md",
        "allowed_tools": [
          "Bash(gh pr list:*)",
          "Bash(gh pr view:*)"
        ]
      },
      "timeout_s": 1800
    },
    {
      "name": "hourly-pr-check",
      "cron": "17 * * * *",
      "missed_run": {
        "kind": "skip"
      },
      "target": "isolated",
      "run": {
        "command": [
          "python3",
          "{agent_home}/agent/private/tools/new_prs.py"
        ],
        "wake_when": "stdout"
      },
      "timeout_s": 120
    }
  ],
  "operator_channels": [
    "plugin:telegram:telegram"
  ],
  "quiet_windows": [
    {
      "start": "23:00",
      "end": "06:30"
    }
  ],
  "notice_routes": {
    "amail": "agent",
    "fleet_watch": "operator",
    "login_expired": "both"
  },
  "keep_harness_idle_compaction": false,
  "wind_down": {
    "skill": "maceff-full-wind-down"
  }
}
